// Lambda（匿名函数表达式）示例：从简单到链式复杂
println("== Lambda examples ==");
let inc = [](x){ return x + 1; };
println("inc(11): ${inc(11)}");

// 简单：单次 then 回调
Promise.resolve(1)
  .then([](v){ return v + 10; })
  .then([](v){ println("v2 ${v}"); return v; })
  .catch([](e){ println("err ${e}"); return 0; });

// 复杂：内联 lambda 立即调用 + then 链 + catch
let r = ([](a,b){ return a*b + 3; })(2, 6);
println("inline IIFE result: ${r}");
Promise.resolve(r)
  .then([](v){ return v * 2; })
  .then([](v){ println("v3 ${v}"); return v - 5; })
  .catch([](e){ println("err chain ${e}"); return 0; });
println("(host should drain event loop to see outputs)");
