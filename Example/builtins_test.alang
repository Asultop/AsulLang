// 验证内置函数 len / push
let s = "hello";
println("len(s)=", len(s));
println("s.len()=", s.len());
println();

let a = [1,2,3];
println("len(a)=", len(a));
println("a.len()=", a.len());
println("a[0]=", a[0]);
println("a[1]=", a[1]);
println("a[2]=", a[2]);

a.push(4);
println("len(a)=", len(a));
println("a.len()=", a.len());
println("a[0]=", a[0]);
println("a[1]=", a[1]);
println("a[2]=", a[2]);
println("a[3]=", a[3]);

push(a, 4, 5);
print("a=", a , "\n" , "len(a)=", len(a));
println();

let o = { x: 1, y: 2 };
println("len(o)=", len(o));

