// 内置函数与方法：len / push 简明示例
println("== Builtins: len / push ==");
let s = "hello";
println("len(s): ${len(s)} | s.len(): ${s.len()}");

let a = [1,2,3];
println("len(a): ${len(a)} | a.len(): ${a.len()} | a: ${a}");
a.push(4);
println("after push(4): len=${len(a)} | a: ${a}");
push(a, 4, 5);
println("after push(a,4,5): len=${len(a)} | a: ${a}");

let o = { x: 1, y: 2 };
println("len(o): ${len(o)} | o: ${o}");

// 复杂：字符串/数组/对象混合
let mix = { s: s, arr: a, o: o };
println("mix sizes => s:${len(mix.s)}, arr:${len(mix.arr)}, o:${len(mix.o)}");

