let a = 42;
let b = { x: 7 };
let s = "value a:${a}, obj.x:${b.x}, math:${a + b.x}";
println(s);

// 只有表达式
println("${a}");

// 前后有文本
println("A:${a}B");

// 对象字面量起始的复杂表达式（现已完全支持）
println("A:${ {k: a}.k }");

// 更复杂的插值示例：函数调用、数组下标、内联对象/数组、计算属性、嵌套对象、await、lambda 调用
function double(x) { return x * 2; }
let arr = [10, 20, 30];
let k1 = "k1";

println("call:${double(a + b.x)}, idx:${arr[1]}, inlineObj:${{ k: a, y: 2 }.k}, inlineArrIdx:${{ arr: [1,2,3,4] }.arr[2]}");
println("computedKey:${{ [k1]: a }.k1}");
println("deep:${{ o: { p: { q: 5 } } }.o.p.q}");
println("await-in-interp:${await sleep(10)}");
println("lambdaCall:${([](x){ return x * 3; })(a)}");
