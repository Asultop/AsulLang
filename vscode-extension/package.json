{
  "name": "alang-language-support",
  "displayName": "ALang Language Support",
  "description": "Syntax highlighting and language support for ALang scripting language",
  "version": "0.1.0",
  "publisher": "asultop",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Asultop/AsulLang"
  },
  "contributes": {
    "languages": [
      {
        "id": "alang",
        "aliases": [
          "ALang",
          "alang"
        ],
        "extensions": [
          ".alang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alang",
        "scopeName": "source.alang",
        "path": "./syntaxes/alang.tmLanguage.json"
      }
    ]
  }
}
