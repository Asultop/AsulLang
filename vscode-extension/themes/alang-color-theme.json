{
  "name": "ALang Default",
  "type": "dark",
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment.line.double-slash.alang",
        "comment.line.number-sign.alang",
        "comment.block.alang",
        "comment.block.triple-quote.alang"
      ],
      "settings": {
        "foreground": "#6A9955",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string.quoted.double.alang",
        "string.quoted.single.alang",
        "string.template.alang"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric.alang",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Keyword Control",
      "scope": [
        "keyword.control.alang",
        "keyword.control.async.alang"
      ],
      "settings": {
        "foreground": "#C586C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type",
      "scope": [
        "storage.type.alang",
        "storage.type.function.alang",
        "storage.type.class.alang"
      ],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword Other",
      "scope": "keyword.other.alang",
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean.alang",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Null",
      "scope": "constant.language.null.alang",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "This",
      "scope": "variable.language.this.alang",
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function Name",
      "scope": "entity.name.function.alang",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Class Name",
      "scope": [
        "entity.name.type.class.alang",
        "entity.name.type.interface.alang",
        "entity.name.type.alang"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Interface Match Operator",
      "scope": "keyword.operator.interface-match.alang",
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Arrow Operators",
      "scope": "keyword.operator.arrow.alang",
      "settings": {
        "foreground": "#FF6B6B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Nullish Operators",
      "scope": "keyword.operator.nullish.alang",
      "settings": {
        "foreground": "#FFD700",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Logical Operators",
      "scope": "keyword.operator.logical.alang",
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Comparison Operators",
      "scope": "keyword.operator.comparison.alang",
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Assignment Operators",
      "scope": "keyword.operator.assignment.alang",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Arithmetic Operators",
      "scope": "keyword.operator.arithmetic.alang",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Bitwise Operators",
      "scope": "keyword.operator.bitwise.alang",
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "name": "Increment Operators",
      "scope": "keyword.operator.increment.alang",
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Spread Operator",
      "scope": "keyword.operator.spread.alang",
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorator Operator",
      "scope": "keyword.operator.decorator.alang",
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "New Operator",
      "scope": "keyword.operator.new.alang",
      "settings": {
        "foreground": "#C586C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator.comma.alang",
        "punctuation.terminator.statement.alang",
        "punctuation.accessor.alang",
        "punctuation.separator.colon.alang"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section.block.begin.alang",
        "punctuation.section.block.end.alang",
        "punctuation.section.brackets.begin.alang",
        "punctuation.section.brackets.end.alang",
        "punctuation.section.parens.begin.alang",
        "punctuation.section.parens.end.alang"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Escape Sequences",
      "scope": "constant.character.escape.alang",
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "name": "Template Interpolation - Expression Background",
      "scope": "meta.embedded.line.alang",
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Template Interpolation - Delimiters",
      "scope": [
        "punctuation.definition.template-expression.begin.alang",
        "punctuation.definition.template-expression.end.alang"
      ],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold"
      }
    }
  ]
}
