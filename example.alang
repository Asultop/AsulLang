// 示例：求和并打印
function add(a, b) { 
    return a + b; 
}

let x = 10; let y = 90;
print("sum:", add(x, y));

let i = 0; let acc = 0;
let cc=9;
while (i < 5) { 
    acc = acc + i; i = i + 1; 
}
if (acc >= 10) {
    print("acc:", acc); 
} else {
    print("small", acc); 
}
print(cc);

// 数组与对象、属性访问与下标赋值
let arr = [1, 2, 3];
arr[1] = 42;
print("arr:", arr);

let obj = { a: 1, b: "hi" };
print("obj.a:", obj.a);
obj["c"] = 7;
print("obj:", obj);

// for/break/continue
let s = 0;
for (let k = 0; k < 10; k = k + 1) {
    if (k == 3) continue;
    if (k == 8) break;
    s = s + k;
}
print("sum for:", s);

print("a","b","c",123,1,796);
